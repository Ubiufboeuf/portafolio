---
import { Icon } from './Icon'
import { IconMail, IconGitHub, IconLinkedin, IconPapers } from './Icons'
import HeroLink from './HeroLink.astro'

const saludo = 'Hola, soy mAngo'
---

<section class='flex flex-col items-center gap-4'>
  <div class='size-40 flex items-center justify-center rounded-full overflow-hidden p-1 border-4 border-mauve'>
    <img src='/profile.webp' class='h-full w-full rounded-full' />
  </div>
  <div class='relative h-fit w-fit'>
    <h1 class='text-3xl md:text-5xl md:leading-relaxed font-extrabold text-transparent text-center'>{saludo}</h1>
    <h1 class='is-dark:opacity-0 absolute top-1/2 -translate-y-1/2 text-3xl md:text-5xl md:leading-relaxed font-extrabold text-transparent text-center bg-clip-text bg-linear-to-r from-peach-light to-mauve-light'>{saludo}</h1>
    <h1 class='opacity-0 is-dark:opacity-100 absolute top-1/2 -translate-y-1/2 text-3xl md:text-5xl md:leading-relaxed font-extrabold text-transparent text-center bg-clip-text bg-linear-to-r from-peach-dark to-mauve-dark'>{saludo}</h1>
  </div>
  <p class='max-w-140 text-center md:text-lg'>+3 años programando. Desarrollador Full-Stack autodidacta, viciado al rendimiento y a las buenas experiencias de usuario.</p>
  <div class='flex items-center justify-center flex-wrap gap-2 mt-2'>
    <HeroLink title='fede.2007.artencio.u@gmail.com' href='mailto:fede.2007.artencio.u@gmail.com' class='font-bold text-crust bg-maroon shr:bg-maroon/80'>
      <Icon class='size-5 stroke-2'>
        <IconMail />
      </Icon>
      <span class='text-sm'>Correo</span>
    </HeroLink>
    <HeroLink title='Ubiufboeuf (mAngo)' href='https://github.com/Ubiufboeuf' class='font-bold text-text bg-crust shr:bg-surface-0/90'>
      <Icon class='size-5 stroke-2'>
        <IconGitHub />
      </Icon>
      <span class='text-sm'>GitHub</span>
    </HeroLink>
    <HeroLink title='Federico Artencio' href='https://www.linkedin.com/in/federico-artencio-8b6667320/' class='font-bold text-crust bg-sky shr:bg-sky/80'>
      <Icon class='size-5 stroke-2'>
        <IconLinkedin />
      </Icon>
      <span class='text-sm'>Linkedin</span>
    </HeroLink>
    <HeroLink title='Descargar CV' download='CV Federico - 2026.pdf' href='/cv.pdf' class='font-bold text-crust bg-peach shr:bg-peach/80'>
      <Icon class='size-5 stroke-2'>
        <IconPapers />
      </Icon>
      <span class='text-sm'>Descargar CV</span>
    </HeroLink>
  </div>
</section>