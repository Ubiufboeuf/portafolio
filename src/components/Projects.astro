---
import { Icon } from './Icon'
import { IconGitHub, IconExternal, IconNPM, IconTerminal } from './Icons'
import { AstroPill, BunPill, PreactPill, TailwindPill, TypeScriptPill } from './Pills'
import ProjectLink from './ProjectLink.astro'

const projects = [
  {
    name: 'Zenith',
    href: 'https://zenith-6nl.pages.dev',
    paragraphs: [
      'Sistema de <b>ventas</b> con gestión de <b>inventario</b> y <b>clientes</b>, diseñado para superar las limitaciones habituales del software de gestión.',
      'Zenith pone el foco tanto en la experiencia de uso como en el <b>rendimiento</b> y la <b>confiabilidad</b>, buscando convertirse en una herramienta en la que puedas apoyarte desde el primer día.'
    ],
    thumbnail: '/zenith.webp',
    aspectRatio: 976 / 438.44,
    technologies: [AstroPill, PreactPill, TailwindPill],
    links: [
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/zenith', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://zenith-6nl.pages.dev', icon: IconExternal }
    ]
  },
  {
    name: 'Monado',
    href: 'https://monado.pages.dev',
    paragraphs: [
      'Reproductor multimedia independiente del proveedor de contenido, diseñado para priorizar el <b>disfrute</b>, la <b>flexibilidad</b> y el <b>rendimiento</b>.',
      'Su arquitectura basada en una <b>API modular</b> permite crear adaptadores y cambiar fácilmente la fuente de contenido, ofreciendo una experiencia <b>desacoplada</b> y adaptable a distintas necesidades.'
    ],
    thumbnail: '/monado.webp',
    aspectRatio: 976 / 549,
    technologies: [AstroPill, PreactPill, TailwindPill],
    links: [
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/monado', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://monado.pages.dev', icon: IconExternal }
    ]
  },
  {
    name: 'yt-kit',
    href: 'https://npmjs.org/@yt-kit/core',
    paragraphs: [
      'SDK modular para desarrollo <b>multimedia</b>, creado como base para construir herramientas como Monado, donde el control no depende de una plataforma externa.',
      'Con una <b>arquitectura flexible</b> y <b>bajo acoplamiento</b>, yt-kit permite manejar contenido de forma consistente, priorizando <b>rendimiento</b>, <b>adaptabilidad</b> y <b>control</b> en cada implementación.'
    ],
    thumbnail: '/yt-kit.webp',
    aspectRatio: 976 / 373.78,
    technologies: [TypeScriptPill, BunPill],
    links: [
      { name: 'GitHub', href: 'https://github.com/Ubiufboeuf/yt-kit', icon: IconGitHub },
      { name: 'NPM', href: 'https://npmjs.org/@yt-kit/core', icon: IconNPM },
      { name: 'Instalar', action: 'navigator.clipboard.writeText("npm install @yt-kit/core")', icon: IconTerminal, type: 'button' },
    ]
  }
]
---

<section id='projects' class='flex flex-col items-center gap-6 pt-18'>
  <h1 class='text-3xl md:text-5xl md:leading-relaxed font-extrabold text-center text-mauve'>Top Proyectos</h1>
  <div class='flex flex-col items-center gap-12'>
    { projects.map(({ name, href, paragraphs, thumbnail, aspectRatio, technologies, links }) => (
      <article class='grid md:grid-cols-2 md:grid-rows-[40px_auto_auto] w-full gap-2 md:gap-x-8'>
        <h1 class='md:col-2 md:row-1 md:text-start text-2xl md:text-4xl font-extrabold flex-1 text-center'>{name}</h1>
        <a href={href} target='_blank' class='md:col-1 md:row-[1/3] md:self-center w-full h-fit rounded-xl overflow-hidden p-1 bg-linear-to-br from-mauve to-peach'>
          <div class='w-full h-fit rounded-lg overflow-hidden p-1 bg-base'>
            <img src={thumbnail} class='w-full h-auto rounded-sm oveflow-hidden' style={`aspect-ratio: ${aspectRatio}`} />
          </div>
        </a>
        <div class='md:col-1 flex items-center justify-center flex-wrap gap-1'>
          { technologies?.map((Pill) => <Pill />) }
        </div>
        <div class='md:row-2 md:col-2 h-fit flex flex-col gap-4 mt-1'>
          { paragraphs.map((paragraph) => <p class='not-md:text-sm text-center md:text-start leading-relaxed text-subtext-1' set:html={paragraph} />) }
        </div>
        <div class='flex justify-center gap-2'>
          { links.map(({ name, href, icon: LinkIcon, type, action }) => (
            <ProjectLink href={href} type={type} action={action} class='group font-bold text-text bg-crust shr:bg-[#323344]'>
              <Icon class='size-5 stroke-crust group-shr:stroke-[#323344]'>
                <LinkIcon />
              </Icon>
              <span class='text-sm'>{name}</span>
            </ProjectLink>
          )) }
        </div>
      </article>
    )) }
  </div>
</section>