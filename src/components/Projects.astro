---
import { Icon } from './Icon'
import { IconGitHub, IconExternal, IconNPM, IconTerminal } from './Icons'
import { AstroPill, BunPill, PreactPill, TailwindPill, TypeScriptPill } from './Pills'
import ProjectLink from './ProjectLink.astro'

const projects = [
  {
    name: 'Zenith',
    href: 'https://zenith-delta-dusky.vercel.app',
    paragraphs: [
      'Sistema de <b>ventas</b> con gestión de <b>inventario</b> y <b>clientes</b>, diseñado para superar las limitaciones habituales del software de gestión.',
      'Zenith pone el foco tanto en la experiencia de uso como en el <b>rendimiento</b> y la <b>confiabilidad</b>, buscando convertirse en una herramienta en la que puedas apoyarte desde el primer día.'
    ],
    thumbnail: '/zenith.webp',
    alt: 'Página de búsqueda de productos del proyecto zenith',
    fetchPriority: 'high',
    aspectRatio: '1920/1080',
    technologies: [AstroPill, PreactPill, TailwindPill],
    links: [
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/zenith', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://zenith-delta-dusky.vercel.app', icon: IconExternal }
    ]
  },
  {
    name: 'YT-DLX',
    href: 'https://www.npmjs.com/package/@yt-dlx/kit',
    paragraphs: [
      'YT-DLX es un conjunto de <b>bibliotecas</b> desarrolladas en <b>TypeScript</b> para descargar, procesar y gestionar contenido multimedia. Incluye tres paquetes independientes: <a href="https://www.npmjs.com/package/@yt-dlx/yt" target="_blank" rel="noopener noreferrer" class="text-blue font-semibold">YT</a>, <a href="https://www.npmjs.com/package/@yt-dlx/media" target="_blank" rel="noopener noreferrer" class="text-blue font-semibold">Media</a> y <a href="https://www.npmjs.com/package/@yt-dlx/streams" target="_blank" rel="noopener noreferrer" class="text-blue font-semibold">Streams</a>.',
      '<b>YT-DLX Kit</b> reúne los tres paquetes en una sola dependencia, permitiendo acceder a sus funcionalidades desde un único punto de entrada. Todos están disponibles en <a rel="noopener noreferrer" target="_blank" href="https://www.npmjs.com/package/@yt-dlx/kit" class="text-blue font-semibold">npm</a>.'
    ],
    thumbnail: '/yt-dlx.webp',
    alt: 'Presentación del ecosistema de bibliotecas YT-DLX',
    aspectRatio: '1920/1080',
    technologies: [TypeScriptPill, BunPill],
    links: [
      { name: 'NPM', href: 'https://www.npmjs.com/package/@yt-dlx/kit', icon: IconNPM },
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/yt-dlx-kit', icon: IconGitHub }
    ]
  },
  {
    name: 'zalk',
    href: 'https://zalk-dun.vercel.app/',
    paragraphs: [
      'Calculadora científica desarrollada con Astro y TypeScript, inspirada en la experiencia de usuario de Samsung Calculator, con un motor matemático propio integrado.',
      'Su motor, <b>Calc</b>, desarrollado desde cero con TypeScript incluye lexer, parser, y evaluador propios, con soporte para funciones, variables complejas. También está disponible en <b>npm</b> como <a ref="noopener noreferrer" target="_blank" href="https://npmjs.org/@mangufaf/zalk" class="text-blue font-semibold">@mangufaf/zalk</a>.'
    ],
    thumbnail: '/zalk.webp',
    alt: 'Ejemplo simple de una operación con zalk',
    aspectRatio: '1920/1080',
    technologies: [AstroPill, TypeScriptPill, BunPill],
    links: [
      { name: 'NPM', href: 'https://npmjs.org/@mangufaf/zalk', icon: IconNPM },
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/zalk', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://zalk-dun.vercel.app/', icon: IconExternal }
    ]
  }
]
---

<section id='projects' class='flex flex-col items-center gap-6 pt-18'>
  <h1 class='text-3xl md:text-5xl md:leading-relaxed font-extrabold text-center text-mauve'>Top Proyectos</h1>
  <div class='flex flex-col items-center gap-12'>
    { projects.map(({ name, href, paragraphs, thumbnail, alt, fetchPriority, aspectRatio, technologies, links }) => (
      <article class='grid md:grid-cols-2 md:grid-rows-[40px_auto_auto] w-full gap-2 md:gap-x-8'>
        <h1 class='md:col-2 md:row-1 md:text-start text-2xl md:text-4xl font-extrabold flex-1 text-center'>{name}</h1>
        <a rel="noopener noreferrer" href={href} target='_blank' class='md:col-1 md:row-[1/3] md:self-center w-full h-fit rounded-xl overflow-hidden p-1 bg-linear-to-br from-mauve to-peach'>
          <div class='w-full h-fit rounded-lg overflow-hidden p-1 bg-base'>
            <img src={thumbnail} alt={alt} fetchpriority={fetchPriority as 'high' | undefined} class='w-full h-auto rounded-sm oveflow-hidden' style={`aspect-ratio: ${aspectRatio}`} />
          </div>
        </a>
        <div class='md:col-1 flex items-center justify-center flex-wrap gap-1'>
          { technologies?.map((Pill) => <Pill />) }
        </div>
        <div class='md:row-2 md:col-2 h-fit flex flex-col gap-4 mt-1 justify-self-center'>
          { paragraphs.map((paragraph) => <p class='not-sm:text-sm leading-relaxed text-subtext-1' set:html={paragraph} />) }
        </div>
        <div class='flex justify-center gap-2'>
          { links.map(({ name, href, icon: LinkIcon }) => (
            <ProjectLink href={href} class='group font-bold text-text bg-crust shr:bg-[#323344]'>
              <Icon class='size-5 stroke-crust group-shr:stroke-[#323344]'>
                <LinkIcon />
              </Icon>
              <span class='text-sm'>{name}</span>
            </ProjectLink>
          )) }
        </div>
      </article>
    )) }
  </div>
</section>