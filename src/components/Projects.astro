---
import { Icon } from './Icon'
import { IconGitHub, IconExternal, IconNPM, IconTerminal } from './Icons'
import { AstroPill, BunPill, PreactPill, TailwindPill, TypeScriptPill } from './Pills'
import ProjectLink from './ProjectLink.astro'

const projects = [
  {
    name: 'Zenith',
    href: 'https://zenith-6nl.pages.dev',
    paragraphs: [
      'Sistema <b>POS</b> con gestión de inventario y clientes integrado, diseñado para optimizar el flujo de trabajo en entornos de ventas y almacenes de alta demanda.',
      'Construido sobre una arquitectura moderna con <b>Astro</b> y <b>Preact</b>, garantizando una interfaz fluida, tiempos de carga mínimos y una integridad de datos robusta para el usuario final.'
    ],
    thumbnail: '/zenith.webp',
    aspectRatio: 976 / 438.44,
    technologies: [AstroPill, PreactPill, TailwindPill],
    links: [
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/zenith', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://zenith-6nl.pages.dev', icon: IconExternal }
    ]
  },
  {
    name: 'Monado',
    href: 'https://monado.pages.dev',
    paragraphs: [
      'Reproductor multimedia y alternativa a YouTube de alto rendimiento, enfocado en ofrecer una experiencia, ligera y libre de distracciones',
      'Actúa como la implementación principal de mi ecosistema yt-kit, demostrando cómo una integración limpia de herramientas multimedia puede transformar la navegación y el consumo de video.'
    ],
    thumbnail: '/monado.webp',
    aspectRatio: 976 / 549,
    technologies: [AstroPill, PreactPill, TailwindPill],
    links: [
      { name: 'Ver en GitHub', href: 'https://github.com/Ubiufboeuf/monado', icon: IconGitHub },
      { name: 'Ir a la web', href: 'https://monado.pages.dev', icon: IconExternal }
    ]
  },
  {
    name: 'yt-kit',
    href: 'https://npmjs.org/@yt-kit/core',
    paragraphs: [
      'SDK modular desarrollado en TypeScript para simplificar la gestión de metadatos, el streaming y el procesamiento de video en aplicaciones web modernas.',
      'Optimizado para entornos de ejecución rápidos como Bun, permite abstraer la complejidad del pipeline multimedia mediante una API intuitiva y estrictamente tipada.'
    ],
    thumbnail: '/yt-kit.webp',
    aspectRatio: 976 / 373.78,
    technologies: [TypeScriptPill, BunPill],
    links: [
      { name: 'GitHub', href: 'https://github.com/Ubiufboeuf/yt-kit', icon: IconGitHub },
      { name: 'NPM', href: 'https://npmjs.org/@yt-kit/core', icon: IconNPM },
      { name: 'Instalar', action: 'navigator.clipboard.writeText("npm install @yt-kit/core")', icon: IconTerminal, type: 'button' },
    ]
  }
]
---

<section id='projects' class='flex flex-col items-center gap-6 pt-18'>
  <h1 class='text-3xl md:text-5xl md:leading-relaxed font-extrabold text-center text-mauve'>Top Proyectos</h1>
  <div class='flex flex-col items-center gap-12'>
    { projects.map(({ name, href, paragraphs, thumbnail, aspectRatio, technologies, links }) => (
      <article class='grid md:grid-cols-2 md:grid-rows-[40px_auto_auto] w-full gap-2 md:gap-x-8'>
        <h1 class='md:col-2 md:row-1 md:text-start text-2xl md:text-4xl font-extrabold flex-1 text-center'>{name}</h1>
        <a href={href} target='_blank' class='md:col-1 md:row-[1/3] md:self-center w-full h-fit rounded-xl overflow-hidden p-1 transition-colors bg-linear-to-br from-mauve to-peach'>
          <div class='w-full h-fit rounded-lg overflow-hidden p-1 transition-colors bg-base'>
            <img src={thumbnail} class='w-full h-auto rounded-sm oveflow-hidden' style={`aspect-ratio: ${aspectRatio}`} />
          </div>
        </a>
        <div class='md:col-1 flex items-center justify-center flex-wrap gap-1'>
          { technologies?.map((Pill) => <Pill />) }
        </div>
        <div class='md:row-2 md:col-2 h-fit flex flex-col gap-3 mt-1'>
          { paragraphs.map((paragraph) => <p class='not-md:text-sm text-center md:text-start transition-colors text-subtext-1' set:html={paragraph} />) }
        </div>
        <div class='flex justify-center gap-2'>
          { links.map(({ name, href, icon: LinkIcon, type, action }) => (
            <ProjectLink href={href} type={type} action={action} class='group font-bold transition-colors **:transition-colors text-text bg-crust shr:bg-[#323344]'>
              <Icon class='size-5 stroke-crust group-shr:stroke-[#323344]'>
                <LinkIcon />
              </Icon>
              <span class='text-sm'>{name}</span>
            </ProjectLink>
          )) }
        </div>
      </article>
    )) }
  </div>
</section>