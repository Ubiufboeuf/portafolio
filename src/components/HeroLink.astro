---
interface Props {
  href?: string
  download?: string
  title?: string
  class?: string
}

const { href, download, title, class: className } = Astro.props
---

<a href={href} download={download} title={title} target='_blank' class={`${className} w-fit h-fit flex items-center justify-center gap-2 p-2 px-3 rounded-lg transition-colors`}>
  <slot />  
</a>