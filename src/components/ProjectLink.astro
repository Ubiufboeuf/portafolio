---
interface Props {
  href?: string
  type?: string
  action?: string
  class?: string
}

const { href, type = 'link', action, class: className } = Astro.props

const isButton = type === 'button'
const Element = isButton ? 'button' : 'a'
---

<Element href={href} target='_blank' onclick={isButton ? action : undefined} class={`${className} w-fit h-fit flex items-center justify-center gap-2 p-2 px-3 rounded-lg cursor-pointer`}>
  <slot />  
</Element>