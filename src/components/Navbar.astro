---
import NavLink from './NavLink.astro'
---

<nav class='fixed z-1 top-4 left-1/2 -translate-x-1/2 h-12 w-full max-w-120 px-4'>
  <div class='relative h-full w-full flex items-center justify-evenly'>
    <div id='nav-bg' class='absolute -z-1 inset-0 h-full w-full rounded-xl transition-colors bg-mantle' />
    <NavLink href='#projects'>
      Proyectos
    </NavLink>
    <NavLink href='#tech'>
      Tecnologías
    </NavLink>
    <NavLink href='#about'>
      Sobre mí
    </NavLink>
  </div>
</nav>

<style>
  #nav-bg {
    animation: float 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 50px;
  }

  @keyframes float {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>