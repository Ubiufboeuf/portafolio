---
import NavLink from './NavLink.astro'
---

<nav class='fixed top-4 left-1/2 -translate-x-1/2 h-12 w-full max-w-120 px-4'>
  <div class='h-full w-full flex items-center justify-evenly rounded-xl'>
    <NavLink href='#projects'>
      Proyectos
    </NavLink>
    <NavLink href='#tech'>
      Tecnologías
    </NavLink>
    <NavLink href='#about'>
      Sobre mí
    </NavLink>
  </div>
</nav>

<style>
  nav > div {
    animation: float 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 50px;
  }

  @keyframes float {
    from {
      background: transparent;
    }

    to {
      background: var(--color-mantle);
    }
  }
</style>